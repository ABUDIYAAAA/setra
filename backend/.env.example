NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/setra_db

# JWT Secrets (replace with strong random keys in production)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars-long!
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
